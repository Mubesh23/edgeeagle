#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
scripts/check-generated
scripts/format-check
scripts/lint
scripts/typecheck
scripts/test-unit
scripts/check-contracts
uv lock --check --offline
scripts/test-integration
scripts/synth
scripts/security-scan
scripts/build
echo 'Workspace, API, and client validation passed (generated drift, format, lint, typecheck, unit tests, lock, builds).'
echo 'Local PostgreSQL, Floci, and provider-mock integration passed.'
echo 'Credential-free CDK synthesis passed.'
echo 'OpenAPI compatibility passed against the pre-release foundation checkpoint.'
echo 'Dependency advisory scans passed. Hosted CI and fresh-checkout evidence must be reported separately.'
