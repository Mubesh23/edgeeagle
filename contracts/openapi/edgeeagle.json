{
  "components": {
    "schemas": {
      "DataSourceId": {
        "description": "Opaque internally assigned source identity, not a provider-native ID.",
        "properties": { "value": { "title": "Value", "type": "string" } },
        "required": ["value"],
        "title": "DataSourceId",
        "type": "object"
      },
      "DatasetErrorResponse": {
        "properties": { "detail": { "title": "Detail", "type": "string" } },
        "required": ["detail"],
        "title": "DatasetErrorResponse",
        "type": "object"
      },
      "DatasetInspection": {
        "properties": {
          "asserted_starts_at_max": {
            "format": "date-time",
            "title": "Asserted Starts At Max",
            "type": "string"
          },
          "asserted_starts_at_min": {
            "format": "date-time",
            "title": "Asserted Starts At Min",
            "type": "string"
          },
          "competition_ids": {
            "items": { "type": "string" },
            "title": "Competition Ids",
            "type": "array"
          },
          "context_versions": {
            "items": { "type": "string" },
            "title": "Context Versions",
            "type": "array"
          },
          "database_acceptance_verified": {
            "const": false,
            "default": false,
            "title": "Database Acceptance Verified",
            "type": "boolean"
          },
          "kickoff_accuracy_verified": {
            "const": false,
            "default": false,
            "title": "Kickoff Accuracy Verified",
            "type": "boolean"
          },
          "metadata": { "$ref": "#/components/schemas/DatasetMetadata" },
          "participant_count": {
            "title": "Participant Count",
            "type": "integer"
          },
          "receipt_count": { "title": "Receipt Count", "type": "integer" },
          "replay_completed_at": {
            "format": "date-time",
            "title": "Replay Completed At",
            "type": "string"
          },
          "replay_status": {
            "const": "VERIFIED",
            "default": "VERIFIED",
            "title": "Replay Status",
            "type": "string"
          },
          "rights_verified": {
            "const": false,
            "default": false,
            "title": "Rights Verified",
            "type": "boolean"
          },
          "season_ids": {
            "items": { "type": "string" },
            "title": "Season Ids",
            "type": "array"
          },
          "sport_ids": {
            "items": { "type": "string" },
            "title": "Sport Ids",
            "type": "array"
          },
          "verification_scope": {
            "const": "RETAINED_ARTIFACT_REPLAY",
            "default": "RETAINED_ARTIFACT_REPLAY",
            "title": "Verification Scope",
            "type": "string"
          }
        },
        "required": [
          "metadata",
          "replay_completed_at",
          "receipt_count",
          "participant_count",
          "asserted_starts_at_min",
          "asserted_starts_at_max",
          "sport_ids",
          "competition_ids",
          "season_ids",
          "context_versions"
        ],
        "title": "DatasetInspection",
        "type": "object"
      },
      "DatasetListResponse": {
        "properties": {
          "items": {
            "items": { "$ref": "#/components/schemas/DatasetListing" },
            "title": "Items",
            "type": "array"
          }
        },
        "required": ["items"],
        "title": "DatasetListResponse",
        "type": "object"
      },
      "DatasetListing": {
        "properties": {
          "metadata": { "$ref": "#/components/schemas/DatasetMetadata" },
          "replay_status": {
            "const": "NOT_CHECKED",
            "default": "NOT_CHECKED",
            "title": "Replay Status",
            "type": "string"
          }
        },
        "required": ["metadata"],
        "title": "DatasetListing",
        "type": "object"
      },
      "DatasetMetadata": {
        "properties": {
          "backtest_eligible": {
            "const": false,
            "default": false,
            "title": "Backtest Eligible",
            "type": "boolean"
          },
          "declared_row_count": {
            "title": "Declared Row Count",
            "type": "integer"
          },
          "ineligibility_reasons": {
            "items": { "type": "string" },
            "title": "Ineligibility Reasons",
            "type": "array"
          },
          "normalizer_version": {
            "default": "football-data-results-mappings-v1",
            "title": "Normalizer Version",
            "type": "string"
          },
          "operator_label": { "title": "Operator Label", "type": "string" },
          "page_count": { "title": "Page Count", "type": "integer" },
          "parser_version": {
            "default": "football-data-results-season-csv-v1",
            "title": "Parser Version",
            "type": "string"
          },
          "raw": { "$ref": "#/components/schemas/RawPayloadReference" },
          "root_hash": { "title": "Root Hash", "type": "string" },
          "usage": {
            "const": "REPLAY_ONLY",
            "default": "REPLAY_ONLY",
            "title": "Usage",
            "type": "string"
          }
        },
        "required": [
          "root_hash",
          "operator_label",
          "raw",
          "declared_row_count",
          "page_count",
          "ineligibility_reasons"
        ],
        "title": "DatasetMetadata",
        "type": "object"
      },
      "EventDetailResponse": {
        "properties": {
          "competition_id": { "title": "Competition Id", "type": "string" },
          "event_id": { "title": "Event Id", "type": "string" },
          "participants": {
            "items": { "$ref": "#/components/schemas/EventEntryResponse" },
            "title": "Participants",
            "type": "array"
          },
          "season_id": { "title": "Season Id", "type": "string" },
          "sport_id": { "title": "Sport Id", "type": "string" },
          "starts_at": {
            "format": "date-time",
            "title": "Starts At",
            "type": "string"
          },
          "status": { "title": "Status", "type": "string" },
          "venue_location": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Venue Location"
          }
        },
        "required": [
          "event_id",
          "sport_id",
          "competition_id",
          "season_id",
          "starts_at",
          "status",
          "venue_location",
          "participants"
        ],
        "title": "EventDetailResponse",
        "type": "object"
      },
      "EventEntryResponse": {
        "properties": {
          "participant_id": { "title": "Participant Id", "type": "string" },
          "role": { "title": "Role", "type": "string" }
        },
        "required": ["participant_id", "role"],
        "title": "EventEntryResponse",
        "type": "object"
      },
      "EventErrorResponse": {
        "properties": { "detail": { "title": "Detail", "type": "string" } },
        "required": ["detail"],
        "title": "EventErrorResponse",
        "type": "object"
      },
      "EventListResponse": {
        "properties": {
          "items": {
            "items": { "$ref": "#/components/schemas/EventResponse" },
            "title": "Items",
            "type": "array"
          },
          "next_after_event_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Next After Event Id"
          }
        },
        "required": ["items", "next_after_event_id"],
        "title": "EventListResponse",
        "type": "object"
      },
      "EventResponse": {
        "properties": {
          "competition_id": { "title": "Competition Id", "type": "string" },
          "event_id": { "title": "Event Id", "type": "string" },
          "season_id": { "title": "Season Id", "type": "string" },
          "sport_id": { "title": "Sport Id", "type": "string" },
          "starts_at": {
            "format": "date-time",
            "title": "Starts At",
            "type": "string"
          },
          "status": { "title": "Status", "type": "string" },
          "venue_location": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Venue Location"
          }
        },
        "required": [
          "event_id",
          "sport_id",
          "competition_id",
          "season_id",
          "starts_at",
          "status",
          "venue_location"
        ],
        "title": "EventResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Process liveness only; this does not assert dependency readiness.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "MarketErrorResponse": {
        "properties": { "detail": { "title": "Detail", "type": "string" } },
        "required": ["detail"],
        "title": "MarketErrorResponse",
        "type": "object"
      },
      "MarketListResponse": {
        "properties": {
          "items": {
            "items": { "$ref": "#/components/schemas/MarketResponse" },
            "title": "Items",
            "type": "array"
          },
          "next_after_market_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Next After Market Id"
          }
        },
        "required": ["items", "next_after_market_id"],
        "title": "MarketListResponse",
        "type": "object"
      },
      "MarketPeriod": {
        "enum": ["REGULATION_TIME"],
        "title": "MarketPeriod",
        "type": "string"
      },
      "MarketResponse": {
        "properties": {
          "event_id": { "title": "Event Id", "type": "string" },
          "market_id": { "title": "Market Id", "type": "string" },
          "market_type": { "$ref": "#/components/schemas/MarketType" },
          "period": { "$ref": "#/components/schemas/MarketPeriod" },
          "selections": {
            "items": { "$ref": "#/components/schemas/MarketSelectionResponse" },
            "title": "Selections",
            "type": "array"
          }
        },
        "required": [
          "market_id",
          "event_id",
          "market_type",
          "period",
          "selections"
        ],
        "title": "MarketResponse",
        "type": "object"
      },
      "MarketSelectionResponse": {
        "properties": {
          "outcome": { "$ref": "#/components/schemas/Outcome" },
          "participant_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Participant Id"
          },
          "selection_id": { "title": "Selection Id", "type": "string" }
        },
        "required": ["selection_id", "outcome", "participant_id"],
        "title": "MarketSelectionResponse",
        "type": "object"
      },
      "MarketType": {
        "enum": ["RESULT_3WAY"],
        "title": "MarketType",
        "type": "string"
      },
      "Outcome": {
        "enum": ["HOME", "DRAW", "AWAY"],
        "title": "Outcome",
        "type": "string"
      },
      "QuoteCaptureResponse": {
        "properties": {
          "available_at": {
            "anyOf": [
              { "format": "date-time", "type": "string" },
              { "type": "null" }
            ],
            "title": "Available At"
          },
          "data_source_id": { "title": "Data Source Id", "type": "string" },
          "effective_at": {
            "anyOf": [
              { "format": "date-time", "type": "string" },
              { "type": "null" }
            ],
            "title": "Effective At"
          },
          "ingested_at": {
            "format": "date-time",
            "title": "Ingested At",
            "type": "string"
          },
          "observed_at": {
            "anyOf": [
              { "format": "date-time", "type": "string" },
              { "type": "null" }
            ],
            "title": "Observed At"
          },
          "resource": { "title": "Resource", "type": "string" }
        },
        "required": [
          "data_source_id",
          "resource",
          "ingested_at",
          "effective_at",
          "observed_at",
          "available_at"
        ],
        "title": "QuoteCaptureResponse",
        "type": "object"
      },
      "QuoteListResponse": {
        "properties": {
          "items": {
            "items": { "$ref": "#/components/schemas/QuoteResponse" },
            "title": "Items",
            "type": "array"
          },
          "next_after_quote_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Next After Quote Id"
          }
        },
        "required": ["items", "next_after_quote_id"],
        "title": "QuoteListResponse",
        "type": "object"
      },
      "QuoteProvenanceResponse": {
        "properties": {
          "context_version": { "title": "Context Version", "type": "string" },
          "normalizer_version": {
            "title": "Normalizer Version",
            "type": "string"
          },
          "parser_version": { "title": "Parser Version", "type": "string" },
          "provider_bookmaker_key": {
            "title": "Provider Bookmaker Key",
            "type": "string"
          },
          "provider_event_id": {
            "title": "Provider Event Id",
            "type": "string"
          },
          "provider_market_key": {
            "title": "Provider Market Key",
            "type": "string"
          },
          "provider_outcome_label": {
            "title": "Provider Outcome Label",
            "type": "string"
          },
          "raw": { "$ref": "#/components/schemas/QuoteRawReferenceResponse" },
          "receipt_id": { "title": "Receipt Id", "type": "string" },
          "usage": {
            "const": "SYNTHETIC_ONLY",
            "title": "Usage",
            "type": "string"
          }
        },
        "required": [
          "receipt_id",
          "raw",
          "provider_event_id",
          "provider_bookmaker_key",
          "provider_market_key",
          "provider_outcome_label",
          "parser_version",
          "normalizer_version",
          "context_version",
          "usage"
        ],
        "title": "QuoteProvenanceResponse",
        "type": "object"
      },
      "QuoteRawReferenceResponse": {
        "properties": {
          "capture": { "$ref": "#/components/schemas/QuoteCaptureResponse" },
          "sha256": { "title": "Sha256", "type": "string" },
          "size_bytes": { "title": "Size Bytes", "type": "integer" }
        },
        "required": ["capture", "sha256", "size_bytes"],
        "title": "QuoteRawReferenceResponse",
        "type": "object"
      },
      "QuoteResponse": {
        "properties": {
          "available_at": {
            "anyOf": [
              { "format": "date-time", "type": "string" },
              { "type": "null" }
            ],
            "title": "Available At"
          },
          "data_source_id": { "title": "Data Source Id", "type": "string" },
          "effective_at": {
            "anyOf": [
              { "format": "date-time", "type": "string" },
              { "type": "null" }
            ],
            "title": "Effective At"
          },
          "ingested_at": {
            "format": "date-time",
            "title": "Ingested At",
            "type": "string"
          },
          "market_id": { "title": "Market Id", "type": "string" },
          "observed_at": {
            "anyOf": [
              { "format": "date-time", "type": "string" },
              { "type": "null" }
            ],
            "title": "Observed At"
          },
          "odds_decimal": {
            "description": "Exact decimal observation, encoded as a string; not an executable price.",
            "title": "Odds Decimal",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/QuoteProvenanceResponse"
          },
          "provider_quote_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Provider Quote Id"
          },
          "quote_id": { "title": "Quote Id", "type": "string" },
          "selection_id": { "title": "Selection Id", "type": "string" },
          "venue_id": { "title": "Venue Id", "type": "string" }
        },
        "required": [
          "quote_id",
          "market_id",
          "selection_id",
          "data_source_id",
          "venue_id",
          "odds_decimal",
          "ingested_at",
          "observed_at",
          "available_at",
          "effective_at",
          "provider_quote_id",
          "provenance"
        ],
        "title": "QuoteResponse",
        "type": "object"
      },
      "RawCapture": {
        "properties": {
          "available_at": {
            "anyOf": [
              { "format": "date-time", "type": "string" },
              { "type": "null" }
            ],
            "title": "Available At"
          },
          "data_source_id": { "$ref": "#/components/schemas/DataSourceId" },
          "effective_at": {
            "anyOf": [
              { "format": "date-time", "type": "string" },
              { "type": "null" }
            ],
            "title": "Effective At"
          },
          "ingested_at": {
            "format": "date-time",
            "title": "Ingested At",
            "type": "string"
          },
          "observed_at": {
            "anyOf": [
              { "format": "date-time", "type": "string" },
              { "type": "null" }
            ],
            "title": "Observed At"
          },
          "resource": { "title": "Resource", "type": "string" }
        },
        "required": ["data_source_id", "resource", "ingested_at"],
        "title": "RawCapture",
        "type": "object"
      },
      "RawPayloadReference": {
        "properties": {
          "capture": { "$ref": "#/components/schemas/RawCapture" },
          "sha256": { "title": "Sha256", "type": "string" },
          "size_bytes": { "title": "Size Bytes", "type": "integer" }
        },
        "required": ["capture", "sha256", "size_bytes"],
        "title": "RawPayloadReference",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": { "title": "Context", "type": "object" },
          "input": { "title": "Input" },
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "title": "Location",
            "type": "array"
          },
          "msg": { "title": "Message", "type": "string" },
          "type": { "title": "Error Type", "type": "string" }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": { "title": "EdgeEagle API", "version": "0.0.0" },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/datasets": {
      "get": {
        "description": "Read selected roots only; never imply that full replay was checked.",
        "operationId": "list_datasets",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DatasetListResponse" }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "List Datasets"
      }
    },
    "/v1/datasets/{rootHash}/inspection": {
      "get": {
        "description": "Freshly replay retained artifacts; never upgrade historical eligibility.",
        "operationId": "inspect_dataset",
        "parameters": [
          {
            "in": "path",
            "name": "rootHash",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "title": "Roothash",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DatasetInspection" }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Inspect Dataset"
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "list_events",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after_event_id",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "After Event Id"
            }
          },
          {
            "in": "query",
            "name": "sport_id",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Sport Id"
            }
          },
          {
            "in": "query",
            "name": "competition_id",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Competition Id"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventListResponse" }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventErrorResponse" }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "List Events"
      }
    },
    "/v1/events/{eventId}": {
      "get": {
        "operationId": "get_event",
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": { "title": "Eventid", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventDetailResponse" }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventErrorResponse" }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventErrorResponse" }
              }
            },
            "description": "Service Unavailable"
