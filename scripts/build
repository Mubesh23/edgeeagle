#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
uv build --package edgeeagle-api --no-build-isolation --offline
uv build --package edgeeagle-domain --no-build-isolation --offline
uv build --package edgeeagle-persistence --no-build-isolation --offline
uv build --package edgeeagle-ingestion --no-build-isolation --offline
PATH="$(pwd)/node_modules/.bin:$PATH" TURBO_TELEMETRY_DISABLED=1 node_modules/.bin/turbo run build
