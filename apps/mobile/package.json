{
  "name": "@edgeeagle/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first EXPO_NO_TELEMETRY=1 expo start --go --localhost",
    "build": "EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo export --platform ios --platform android --output-dir dist --max-workers 2",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "expo": "56.0.22",
    "expo-constants": "56.0.26",
    "expo-linking": "56.0.18",
    "expo-router": "56.2.21",
    "expo-status-bar": "56.0.4",
    "@expo/log-box": "56.0.14",
    "@expo/metro-runtime": "56.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-preset-expo": "56.0.20",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
