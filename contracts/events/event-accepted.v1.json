{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventAccepted v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "version",
    "occurred_at",
    "published_at",
    "correlation_id",
    "causation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "event_type": { "const": "EventAccepted" },
    "version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "causation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_event_id", "acceptance_key"],
      "properties": {
        "canonical_event_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "acceptance_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
