#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
corepack pnpm run lint
for script in scripts/*; do
  [[ -f "$script" ]] || continue
  if [[ "$(head -n 1 "$script")" == '#!/usr/bin/env bash' ]]; then
    bash -n "$script"
  fi
done
for script in scripts/*.mjs scripts/tests/*.mjs scripts/contract-tests/*.mjs libs/typescript/api-client/tests/*.mjs; do
  node --check "$script"
done
uv run --locked --offline --all-packages ruff check .
PATH="$(pwd)/node_modules/.bin:$PATH" TURBO_TELEMETRY_DISABLED=1 node_modules/.bin/turbo run lint
